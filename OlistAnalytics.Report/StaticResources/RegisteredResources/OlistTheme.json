{
  "name": "Olist Analytics",
  "dataColors": [
    "#1F6FB2",
    "#F28C28",
    "#2BA58C",
    "#7B5EA7",
    "#A88A1E",
    "#C2508F",
    "#4FA3D9",
    "#D64550"
  ],
  "foreground": "#1F2A37",
  "foregroundNeutralSecondary": "#5B6675",
  "background": "#FFFFFF",
  "tableAccent": "#1F6FB2",
  "good": "#2BA58C",
  "neutral": "#F2B33D",
  "bad": "#D64550",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1F2A37"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#1F2A37"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#5B6675"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E7ED"
              }
            },
            "radius": 8
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F2A37"
              }
            },
            "fontSize": 11
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F2A37"
              }
            },
            "fontSize": 22
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#5B6675"
              }
            },
            "fontSize": 10
          }
        ]
      }
    }
  }
}