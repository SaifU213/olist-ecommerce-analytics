	partition Reviews = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase),
				    Data = Source{[Schema = "dw", Item = "fact_reviews"]}[Data],
				    Selected = Table.SelectColumns(Data, {"review_id", "order_id", "review_score", "comment_title", "comment_message", "review_date", "answer_ts", "sentiment", "has_comment"}),
				    Renamed = Table.RenameColumns(Selected, {{"review_id", "Review ID"}, {"order_id", "Order ID"}, {"review_score", "Review Score"}, {"comment_title", "Comment Title"}, {"comment_message", "Comment Message"}, {"review_date", "Review Date"}, {"answer_ts", "Answer Timestamp"}, {"sentiment", "Sentiment"}, {"has_comment", "Has Comment"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Review ID", type text}, {"Order ID", type text}, {"Review Score", Int64.Type}, {"Comment Title", type text}, {"Comment Message", type text}, {"Review Date", type date}, {"Answer Timestamp", type datetime}, {"Sentiment", type text}, {"Has Comment", type logical}})
				in
				    Typed

